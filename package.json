{
  "name": "zenwalls-collection",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "set REACT_NATIVE_ARCHITECTURES=arm64-v8a,x86_64 && expo run:android",
    "android:clean": "rmdir /s /q android\\.cxx && rmdir /s /q android\\build && rmdir /s /q android\\app\\build",
    "android:fresh": "npm run android:clean && npm install && cd android && gradlew clean && cd .. && npm run android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android"
  },
  "dependencies": {
    "@nkzw/create-context-hook": "^1.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.90.21",
    "ajv": "^8.18.0",
    "diff": "^8.0.3",
    "expo": "~54.0.33",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-intent-launcher": "~13.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-modules-core": "~3.0.29",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "lucide-react-native": "^0.542.0",
    "node-forge": "^1.3.3",
